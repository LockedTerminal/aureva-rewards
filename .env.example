# ─────────────────────────────────────────────────────────────────
# Aureva Rewards — Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/aureva_rewards

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ───────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-minimum-32-characters-long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Stellar Network ──────────────────────────────────────────────
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Stellar Distribution Account ────────────────────────────────
ISSUER_PUBLIC=YOUR_STELLAR_PUBLIC_KEY
ISSUER_SECRET=YOUR_STELLAR_SECRET_KEY

# ── Aureva Token ────────────────────────────────────────────────
TOKEN_CONTRACT_ID=YOUR_AUREVA_TOKEN_CONTRACT_ID
REWARD_POOL_CONTRACT_ID=YOUR_REWARD_POOL_CONTRACT_ID
DISTRIBUTION_CONTRACT_ID=YOUR_DISTRIBUTION_CONTRACT_ID
CAMPAIGN_CONTRACT_ID=YOUR_CAMPAIGN_CONTRACT_ID
REDEMPTION_CONTRACT_ID=YOUR_REDEMPTION_CONTRACT_ID
ADMIN_ROLES_CONTRACT_ID=YOUR_ADMIN_ROLES_CONTRACT_ID

# ── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# ── Email (optional) ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@aureva-rewards.io

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
